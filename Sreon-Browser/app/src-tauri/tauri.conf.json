{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sreon",
  "version": "0.1.0",
  "identifier": "com.sreon.browser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {"withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Sreon",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
